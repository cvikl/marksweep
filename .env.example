# Meta Model API key from https://dev.meta.ai (dashboard > API keys)
MODEL_API_KEY=
# Where sweeps, crops and records are stored
MARKSWEEP_DATA=./data
# Set to 1 to run without the API using the recorded fixtures (demo and tests)
MARKSWEEP_FIXTURE=0
# Required on a public host for mutating calls (new sweeps); leave empty locally
MARKSWEEP_TOKEN=
