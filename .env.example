# Route A (default): Meta's open-weight Muse Glimmer 30B served locally by scripts/glimmer-server.sh
MODEL_API_KEY=local
MARKSWEEP_BASE_URL=http://127.0.0.1:8080/v1
MARKSWEEP_SPARK_MODEL=muse-glimmer-30B
MARKSWEEP_SEGMENTER=vlm
MARKSWEEP_IMAGE_MAX_SIDE=1024
# Route B: Meta Model API (needs a key with billing enabled at https://dev.meta.ai)
# MODEL_API_KEY=LLM_...
# MARKSWEEP_BASE_URL=https://api.meta.ai/v1
# MARKSWEEP_SPARK_MODEL=muse-spark-1.3
# MARKSWEEP_SEGMENTER=sam
# Where sweeps, crops and records are stored
MARKSWEEP_DATA=./data
# Set to 1 to run without any model using the recorded fixtures (public demo host, tests)
MARKSWEEP_FIXTURE=0
# Required on a public host for new sweeps; leave empty locally
MARKSWEEP_TOKEN=
